# Use the same verified release and shared secret values on both hosts.
# Supply staging credentials in a private host environment file.
HA_NEXT_DIR=/opt/omniroute-ha/.work/backend
HA_MONGO_URI=mongodb://mongo-a:27017,mongo-b:27017,mongo-c:27017/?replicaSet=staging
HA_MONGO_DATABASE=ha_test_staging
NODE_ENV=production
TZ=UTC
# Key USD weekly mode; configure identically on both hosts.
OMNIROUTE_API_KEY_WEEKLY_WINDOW=provider
# In calendar mode an empty timezone uses TZ; provider mode ignores this value.
OMNIROUTE_API_KEY_WEEKLY_WINDOW_TIMEZONE=
NEXT_TELEMETRY_DISABLED=1
OMNIROUTE_HA_IDENTITY=synthetic-shared-staging-deployment
HA_STATUS_TOKEN=
# Private management origin for host status; do not expose /ha/status via ingress.
# HA_STATUS_URL=http://host-a.private:20128
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
# Fresh database only: original headless administrator bootstrap. Keep identical
# on both hosts; an existing stored password takes precedence. Never use CHANGEME.
INITIAL_PASSWORD=

# Private per-host local directory; never a shared SQLite volume.
DATA_DIR=/opt/omniroute-ha/.work/data
TMPDIR=/opt/omniroute-ha/.work/data
OMNIROUTE_PLUGINS_DIR=/opt/omniroute-ha/.work/data/plugins
HOST=0.0.0.0
PORT=20128
# HA overlay retains the dashboard/authz; this gates optional boot subsystems.
OMNIROUTE_HEADLESS=1
OMNIROUTE_DISABLE_BACKGROUND_SERVICES=true
OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK=true
# Owned token-health: Openference, Claude, Codex, Cline/ClinePass, Kimi, GitLab Duo,
# Kiro/Amazon Q and GitHub App. Unreviewed provider contracts fail closed.
OMNIROUTE_DISABLE_TOKEN_HEALTHCHECK=false
# Original Provider Limits sync runs on the fenced active, despite the global
# optional-background flag. Serial provider polling retains original spacing.
OMNIROUTE_DISABLE_PROVIDER_LIMITS_SYNC=false
# Original opt-in recovery tickets are processed only by the active owner.
OMNIROUTE_DISABLE_QUOTA_SESSION_RECOVERY=false
# PROVIDER_LIMITS_SYNC_INTERVAL_MINUTES=70
# PROVIDER_LIMITS_SYNC_SPACING_MS=1500
# Original Free Proxy auto-sync, owned by the active instance only. Off by default.
FREE_PROXY_AUTO_SYNC_ENABLED=false
# Original interval/default and five-minute courtesy floor are retained.
# FREE_PROXY_AUTO_SYNC_INTERVAL_MS=1800000
# Optional original typed-memory policy, executed by the fenced active only.
# Disabled unless both the master switch and a positive interval are supplied.
MEMORY_TYPED_DECAY_ENABLED=false
# MEMORY_TYPED_DECAY_SWEEP_INTERVAL=3600
# MEMORY_TYPED_DECAY_EPISODIC_DAYS=30
# MEMORY_TYPED_DECAY_ACCESS_IMMUNITY=3
PROXY_HEALTH_ENABLED=false
REQUIRE_API_KEY=true
OMNIROUTE_DISABLE_REDIS_AUTH_CACHE=1
OMNIROUTE_DISABLE_CLI_TOKEN=true
DISABLE_SQLITE_AUTO_BACKUP=1

# Opt-in, operator-certified bounds for single-attempt Chat/Responses via Chat nodes.
# tokens covers TOTAL accepted input/output liability, including injected context;
# nanoUsd is integer USD * 1e9. Never use unverified example values.
# HA_QUOTA_BOUNDS={"openai-compatible-example/model":{"tokens":131072,"nanoUsd":2000000000}}
# Optional defaultOutputTokens supplies a missing output cap on the wire; its
# positive value must fit tokens. Explicit client caps always retain priority.
# Optional tools=true enables bounded function tools/history. maxImages and
# maxAudioBytes enable bounded image/audio INPUT and require mediaPricing:
# "provider" requires an exact provider cost; "tokens" certifies token billing
# covers all media. These bounds include injected context and all billable work.
# Output audio, n>1 and uncertified executor/endpoints remain fail-closed.
# Set identically on both hosts for strict projected hard shares in countable
# pools; the upstream default 0.5 permits borrowing below the global cap.
# QUOTA_SATURATION_THRESHOLD=0
# Responses continuation needs POST /api/logs/detail with {"enabled":true};
# retain complete non-redacted artifacts under the original privacy policy.

# Configure Redis before launching either instance. Qualify the target
# topology, TLS, and ACLs on both hosts.
# direct covers a Redis URL or an infrastructure VIP.
HA_REDIS_MODE=disabled
# REDIS_URL=rediss://staging-cache.example:6380
# HA_REDIS_MODE=sentinel
# HA_REDIS_NODES=[{"host":"sentinel-a","port":26379},{"host":"sentinel-b","port":26379}]
# HA_REDIS_MASTER=staging-cache
# HA_REDIS_MODE=cluster
# HA_REDIS_NODES=[{"host":"cluster-a","port":6379},{"host":"cluster-b","port":6379}]
# HA_REDIS_TLS=true
# HA_REDIS_SENTINEL_TLS=true
